# Hacklog environment configuration
# Copy to .env and fill in required secrets before starting the application.

# --- Required SMTP secrets ---
HACKLOG_SMTP_USER=<your-smtp-username>
HACKLOG_SMTP_PASSWORD=<your-smtp-password>
HACKLOG_SMTP_SENDER=<your-smtp-sender@example.com>
HACKLOG_SMTP_HOST=smtp.gmail.com
HACKLOG_SMTP_PORT=587
HACKLOG_ALERT_RECIPIENT=<your-alert-recipient@example.com>
# HACKLOG_ALLOWED_CIDRS=10.0.0.0/8,192.168.0.0/16

# --- Optional metrics overrides ---
# HACKLOG_METRICS_ENABLED=false
# HACKLOG_METRICS_PORT=9090

# --- Optional syslog listener overrides ---
# HACKLOG_SYSLOG_BIND_ADDRESS=127.0.0.1
# HACKLOG_SYSLOG_PORT=10514
# HACKLOG_SYSLOG_MAX_MESSAGE_SIZE=8192
# HACKLOG_SYSLOG_RATE_LIMIT_PER_SOURCE=100

# --- Optional database overrides ---
# HACKLOG_DATABASE_DB_URL=sqlite:///hacklog.db
# HACKLOG_DATABASE_POOL_SIZE=5

# --- Optional security overrides ---
# HACKLOG_SECURITY_ALLOWED_SOURCE_CIDRS=10.0.0.0/8,192.168.0.0/16

# --- Optional scoring parameter overrides (defaults match legacy algorithm.py constants) ---
#
# HACKLOG_SCORING_HOURS_WEIGHT
#   Purpose: Weight applied to the time-of-day anomaly sub-score.
#   The sub-score measures how unusual the login hour is relative to the user's profile.
#   Valid range: 0-100. Impact: higher values increase sensitivity to logins at unusual hours.
#   Default: 10
# HACKLOG_SCORING_HOURS_WEIGHT=10
#
# HACKLOG_SCORING_DAYS_WEIGHT
#   Purpose: Weight applied to the day-of-week anomaly sub-score.
#   The sub-score measures how unusual the login day is relative to the user's profile.
#   Valid range: 0-100. Impact: higher values increase sensitivity to logins on unusual days.
#   Default: 10
# HACKLOG_SCORING_DAYS_WEIGHT=10
#
# HACKLOG_SCORING_SERVER_WEIGHT
#   Purpose: Weight applied to the server access anomaly sub-score.
#   The sub-score measures how rarely the user accesses the target server.
#   Valid range: 0-100. Impact: higher values increase sensitivity to logins on unfamiliar servers.
#   Default: 15
# HACKLOG_SCORING_SERVER_WEIGHT=15
#
# HACKLOG_SCORING_SUCCESS_WEIGHT
#   Purpose: Penalty added to the total score for failed authentication attempts.
#   A failed login (success=false) adds this weight directly to the score; success adds 0.
#   Valid range: 0-100. Impact: higher values flag failed login patterns more aggressively.
#   Default: 35
# HACKLOG_SCORING_SUCCESS_WEIGHT=35
#
# HACKLOG_SCORING_VPN_WEIGHT
#   Purpose: IP location score applied when the source IP is identified as a VPN address.
#   Valid range: 0-100. Impact: set above 0 to add VPN-source logins to the anomaly score.
#   Default: 0 (VPN traffic is not penalized by default)
# HACKLOG_SCORING_VPN_WEIGHT=0
#
# HACKLOG_SCORING_INTERNAL_WEIGHT
#   Purpose: IP location score applied when the source IP is an internal (RFC-1918) address.
#   Valid range: 0-100. Impact: higher values increase sensitivity to internal-source logins.
#   Default: 10
# HACKLOG_SCORING_INTERNAL_WEIGHT=10
#
# HACKLOG_SCORING_EXTERNAL_WEIGHT
#   Purpose: IP location score applied when the source IP is an external (public) address.
#   Valid range: 0-100. Impact: higher values increase sensitivity to external-source logins.
#   Default: 15
# HACKLOG_SCORING_EXTERNAL_WEIGHT=15
#
# HACKLOG_SCORING_IP_WEIGHT
#   Purpose: Weight applied to the source IP frequency anomaly sub-score.
#   The sub-score measures how rarely the user connects from the source IP.
#   Valid range: 0-100. Impact: higher values increase sensitivity to logins from new IPs.
#   Default: 15
# HACKLOG_SCORING_IP_WEIGHT=15
#
# HACKLOG_SCORING_CRITICAL_THRESHOLD
#   Purpose: Total score above which an immediate alert email is sent for a single event.
#   Valid range: 0-1000. Impact: lower values make alerting more sensitive (more alerts);
#   higher values reduce false positives but may miss low-scoring anomalies.
#   Default: 50
# HACKLOG_SCORING_CRITICAL_THRESHOLD=50
#
# HACKLOG_SCORING_SCARY_THRESHOLD
#   Purpose: Total score above which the user's "scare count" is incremented.
#   When the scare count reaches HACKLOG_SCORING_SCARE_COUNT_LIMIT an alert is sent.
#   Valid range: 0-1000. Impact: lower values begin escalation tracking sooner.
#   Default: 30
# HACKLOG_SCORING_SCARY_THRESHOLD=30
#
# HACKLOG_SCORING_SCARE_COUNT_LIMIT
#   Purpose: Number of consecutive scary-threshold breaches required before an alert is sent.
#   Provides hysteresis to reduce alerts from one-off anomalous logins.
#   Valid range: 1-100. Impact: lower values alert after fewer repeated anomalies.
#   Default: 2
# HACKLOG_SCORING_SCARE_COUNT_LIMIT=2
#
# HACKLOG_SCORING_SCARE_DATE_EXPIRE_DAYS
#   Purpose: Days of clean (below-scary) activity after which the user's scare count resets to 0.
#   Valid range: 0-365. Impact: lower values reset escalation counters sooner;
#   higher values keep users under scrutiny for longer.
#   Default: 1
# HACKLOG_SCORING_SCARE_DATE_EXPIRE_DAYS=1
